[buildPlans.iosevka-custom]
family = "Iosevka Custom"
spacing = "term"
serifs = "slab"
no-cv-ss = true

[buildPlans.iosevka-custom.variants.design]
capital-a = "straight-base-serifed"
capital-b = "standard-bilateral-serifed"
capital-c = "serifless"
capital-e = "serifed"
capital-f = "serifed"
capital-g = "toothless-corner-serifed-hooked"
capital-j = "serifed-both-sides"
capital-q = "crossing-curly-tailed"
capital-r = "straight"
capital-s = "bilateral-serifed"
capital-z = "straight-serifed-with-horizontal-crossbar"
a = "double-storey-serifed"
b = "toothed"
f = "serifed-crossbar-at-x-height"
g = "double-storey-open"
h = "straight"
k = "curly-serifed"
n = "straight"
t = "standard"
z = "straight-serifed-with-horizontal-crossbar"
turn-v = "straight"
lower-alpha = "crossing"
cyrl-capital-ka = "symmetric-connected-serifed"
cyrl-el = "straight"
cyrl-ef = "serifed"
cyrl-capital-u = "straight"
cyrl-capital-ya = "curly"
cyrl-ya = "straight"
one = "base"
two = "curly-neck"
three = "flat-top"
four = "semi-open"
five = "vertical-upper-left-bar"
six = "straight-bar"
seven = "curly-crossbar-serifed"
eight = "crossing"
nine = "straight-bar"
asterisk = "penta-low"
underscore = "high"
paragraph-sign = "high"
caret = "medium"
paren = "normal"
brace = "curly"
number-sign = "upright"
ampersand = "upper-open"
at = "fourfold"
dollar = "through"
cent = "through"
percent = "rings-segmented-slash"
ascii-single-quote = "straight"
question = "smooth"
punctuation-dot = "round"

[buildPlans.iosevka-custom.variants.italic]
a = "single-storey-tailed"
d = "tailed-serifed"
e = "rounded"
f = "tailed-crossbar-at-x-height"
k = "diagonal-tailed-cursive-top-left-serifed"
p = "motion-serifed"
q = "diagonal-tailed"
r = "top-serifed"
z = "cursive-with-horizontal-crossbar"
ampersand = "upper-open"
dollar = "interrupted"
question = "smooth"
