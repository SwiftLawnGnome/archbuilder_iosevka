capital-i = "serifed"
capital-j = "serifed-both-sides"
capital-k = "curly-serifed"
capital-m = "hanging-serifed"
capital-n = "standard-serifed"
capital-p = "open-serifed"
capital-q = "crossing-curly-tailed"
capital-r = "curly-open-top-left-and-bottom-right-serifed"
capital-t = "serifed"
capital-u = "toothless-rounded-serifed"
capital-y = "straight-serifed"
capital-z = "straight-serifed-with-horizontal-crossbar"
a = "double-storey-serifed"
d = "toothed-serifed"
e = "flat-crossbar"
f = "serifed"
g = "double-storey-open"
l = "serifed-diagonal-tailed"
t = "diagonal-tailed"
w = "straight-serifed"
z = "straight-serifed-with-horizontal-crossbar"
