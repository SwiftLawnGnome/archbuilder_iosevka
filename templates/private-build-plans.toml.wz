[buildPlans.iosevka-custom]
family = "Iosevka Custom"
spacing = "term"
serifs = "slab"
no-cv-ss = false

[buildPlans.iosevka-custom.variants.design]
capital-g = "toothless-corner-serifed-hooked"
capital-j = "serifed-both-sides"
capital-q = "crossing-curly-tailed"
capital-r = "curly"
capital-z = "straight-serifed-with-horizontal-crossbar"
d = "tailed-serifed"
g = "double-storey-open"
k = "curly-serifed"
l = "serifed-diagonal-tailed"
z = "straight-serifed-with-horizontal-crossbar"
cyrl-che = "standard"
cyrl-ya = "curly"
three = "flat-top"
seven = "straight-crossbar-serifed"
asterisk = "penta-low"
ampersand = "upper-open"
at = "fourfold"

[buildPlans.iosevka-custom.variants.italic]
capital-q = "detached-bend-tailed"
capital-r = "curly-open-motion-serifed"
capital-w = "straight-flat-top-motion-serifed"
capital-x = "straight-motion-serifed"
capital-z = "cursive-with-crossbar"
a = "single-storey-serifed"
f = "flat-hook-diagonal-tailed"
k = "diagonal-tailed-cursive-serifless"
x = "straight-motion-serifed"
z = "cursive-with-crossbar"
seven = "bend-crossbar-serifed"
